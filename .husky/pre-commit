# https://typicode.github.io/husky/guide.html#with-env-variables
[ -n "$CI" ] && exit 0

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "You can't commit directly to main branch"
  exit 1
fi

export TURBO_NO_UPDATE_NOTIFIER=1

# Format staged files via lint-staged in each changed package
yarn turbo run precommit --filter='[HEAD]' --concurrency=1

# Type-check changed packages (turbo builds upstream deps as needed)
yarn turbo run check --filter='[HEAD]'