{
  "name": "@neat-evolution/demo",
  "version": "0.5.8",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-evolution/neat-evolution.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "yarn clean && concurrently --timings --prefix --names \"cjs,esm,tsc\" \"yarn build:cjs\" \"yarn build:esm\" \"yarn build:types\"",
    "build:cjs": "mkdir -p dist/cjs && echo '{\"type\":\"commonjs\",\"main\":\"./index.js\"}' > dist/cjs/package.json && swc src -d dist/cjs --source-maps --strip-leading-paths --copy-files -C module.type=commonjs",
    "build:esm": "swc src -d dist/esm --source-maps --strip-leading-paths --copy-files -C module.type=es6",
    "build:types": "tsgo --declaration --emitDeclarationOnly --project tsconfig.types.json --outDir dist/types",
    "clean": "rimraf dist coverage",
    "coverage": "vitest --coverage",
    "debug": "yarn build && nodemon --exec 'node --inspect=0.0.0.0:9229 ./dist/esm/index.js'",
    "dev": "yarn clean && concurrently --timings --prefix --names \"cjs,esm,tsc\" \"yarn dev:cjs\" \"yarn dev:esm\" \"yarn dev:types\"",
    "dev:cjs": "mkdir -p dist/cjs && echo '{\"type\":\"commonjs\",\"main\":\"./index.js\"}' > dist/cjs/package.json && swc --watch src -d dist/cjs --strip-leading-paths --source-maps --copy-files -C module.type=commonjs",
    "dev:esm": "swc --watch src -d dist/esm --strip-leading-paths --source-maps --copy-files -C module.type=es6",
    "dev:types": "tsc --watch --declaration --emitDeclarationOnly --project tsconfig.types.json --outDir dist/types",
    "dev:workspace": "turbo run dev --filter=@neat-evolution/demo... --concurrency 20",
    "demo": "node ./dist/esm/worker.js",
    "start": "caffeinate -s node ./dist/esm/worker.js",
    "format": "biome check --write",
    "lint": "biome lint",
    "precommit": "lint-staged",
    "test": "vitest --run",
    "bench": "vitest bench --run",
    "profile": "node --prof ./scripts/profile.js && node --prof-process --preprocess -j isolate-*.log > profile.json && rm isolate-*.log && node ./scripts/analyze-profile.js",
    "profile:worker": "node --prof ./dist/esm/worker.js && node --prof-process --preprocess -j isolate-*.log > profile-worker.json && rm isolate-*.log && node ./scripts/analyze-profile.js profile-worker.json",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "@neat-evolution/core": "workspace:^",
    "@neat-evolution/cppn": "workspace:^",
    "@neat-evolution/dataset-environment": "workspace:^",
    "@neat-evolution/des-hyperneat": "workspace:^",
    "@neat-evolution/environment": "workspace:^",
    "@neat-evolution/es-hyperneat": "workspace:^",
    "@neat-evolution/evaluation-strategy": "workspace:^",
    "@neat-evolution/evaluator": "workspace:^",
    "@neat-evolution/evolution": "workspace:^",
    "@neat-evolution/executor": "workspace:^",
    "@neat-evolution/hyperneat": "workspace:^",
    "@neat-evolution/neat": "workspace:^",
    "@neat-evolution/worker-evaluator": "workspace:^",
    "@neat-evolution/worker-reproducer": "workspace:^",
    "@neat-evolution/worker-threads": "workspace:^",
    "@swc/helpers": "^0.5.17",
    "quick-lru": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@heygrady/tsconfig-bases": "^1.0.7",
    "@neat-evolution/utils": "workspace:^",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@tsconfig/node22": "^22.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260220.1",
    "@vitest/coverage-v8": "^4.0.14",
    "concurrently": "^9.2.1",
    "execa": "^9.6.1",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "turbo": "^2.8.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "browserslist": [
    "node >=16"
  ],
  "engines": {
    "node": ">=16"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "yarn@4.12.0"
}
