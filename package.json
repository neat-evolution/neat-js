{
  "name": "neat-evolution",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-evolution/neat-js.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*",
    ".claude/skills/*"
  ],
  "scripts": {
    "build": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run build --output-logs=errors-only",
    "change": "beachball change --no-commit && git commit -a -m \"chore: add change files\"",
    "check": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run check --output-logs=errors-only",
    "check:repo": "yarn check && yarn check:manypkg && yarn check:beachball",
    "check:beachball": "beachball check",
    "check:manypkg": "manypkg check",
    "clean": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run clean",
    "clean:hard": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run clean --force && find . -name node_modules -type d -prune -exec rm -rf {} +",
    "claude": "yarn dlx @anthropic-ai/claude-code",
    "coverage": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run coverage --output-logs=errors-only",
    "coverage:ci": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run coverage --concurrency=2 --output-logs=errors-only",
    "demo": "yarn build && yarn workspace @neat-evolution/demo start",
    "format": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run format --output-logs=errors-only",
    "gemini": "yarn dlx @google/gemini-cli",
    "lint": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run lint --output-logs=errors-only",
    "prepare": "husky",
    "release": "beachball publish",
    "test": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run test --output-logs=errors-only",
    "test:ci": "TURBO_NO_UPDATE_NOTIFIER=1 turbo run test --concurrency=2 --output-logs=errors-only",
    "work-session": "node ../tone-studio/scripts/work-session/bin/index.js"
  },
  "packageManager": "yarn@4.12.0",
  "volta": {
    "node": "24.11.1",
    "npm": "11.6.4",
    "yarn": "4.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/config-workspace-scopes": "^20.0.0",
    "@manypkg/cli": "^0.25.1",
    "beachball": "^2.58.0",
    "husky": "^9.1.7",
    "turbo": "^2.8.16"
  }
}
